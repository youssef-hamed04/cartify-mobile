# Copy to .env.local and adjust. Only EXPO_PUBLIC_* values reach the app, and they are
# bundled into the binary, so never put secrets here.

# Backend base URL (no trailing slash).
# Leave unset during development: the app then uses http://<your dev machine IP>:3001,
# which works on emulators and on phones on the same Wi-Fi.
# Android emulator without Expo dev server: http://10.0.2.2:3001
# Production / store builds must use HTTPS, e.g. https://cartify-backend-mqtt.vercel.app
EXPO_PUBLIC_API_URL=
